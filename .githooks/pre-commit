#!/bin/sh
# Bloqueia commit de segredos hardcoded (chaves de API, tokens, senhas em
# texto puro). Roda automaticamente porque `npm install` configura
# core.hooksPath pra apontar aqui (ver script "prepare" em package.json) —
# nenhum dev precisa instalar nada à parte.
#
# Detecta: chaves de service_role do Supabase, prefixos comuns de chave de
# API (sk_live/sk_test/AKIA da AWS), blocos de chave privada PEM, e
# atribuições de "senha"/"password"/"pin" a uma string literal.

padrao='service_role|SERVICE_ROLE|sk_live_|sk_test_|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(senha|password|pin)[a-zA-Z_]*[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{4,}["'"'"']'

achados=$(git diff --cached -U0 --diff-filter=ACM -- . \
    ':(exclude)*.lock' ':(exclude)package-lock.json' ':(exclude).githooks/pre-commit' \
  | grep -E '^\+' | grep -viE '^\+\+\+' | grep -inE "$padrao" \
  | grep -viE '\.env\.get\(|process\.env\.')

if [ -n "$achados" ]; then
  echo "Commit bloqueado — isso parece uma chave/senha hardcoded:"
  echo "$achados"
  echo ""
  echo "Segredos vao em .env.local (nunca commitado, ver .gitignore), nunca no codigo."
  echo "Se for falso positivo, ajuste o padrao em .githooks/pre-commit."
  exit 1
fi
