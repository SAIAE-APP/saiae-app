+/** Patch Sai aê: cancelDiscovery() exige BLUETOOTH_SCAN no Android 12+ (não
+ * declarada pelo plugin) e lançava SecurityException, reportada como falta de
+ * BLUETOOTH_CONNECT. Cancelar a busca é só otimização — ignora se não puder. */
+@SuppressLint("MissingPermission")
+private fun cancelarDescobertaSePermitido(adapter: android.bluetooth.BluetoothAdapter) {
+    try {
+        adapter.cancelDiscovery()
+    } catch (e: SecurityException) {
+        // sem BLUETOOTH_SCAN: segue sem cancelar a descoberta
+    }
+}
